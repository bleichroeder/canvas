# Backend URL. Production (hosted) canvas uses the CF Worker:
#   https://canvas-api.<your-account>.workers.dev
# Local development against the new self-hosted Bun server:
#   http://localhost:8787
VITE_CANVAS_API=https://canvas-api.<your-account>.workers.dev

# Supabase project — powers email/password + Google auth and cloud source sync.
# Both values are safe to bake into the client bundle (anon key by design).
# Find under your Supabase project's Settings → API.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-publishable-key>
